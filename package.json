{
  "name": "sabi-detective",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:bundle": "next build && node --env-file-if-exists=.env.local scripts/check-bundle.mjs",
    "check:public-access": "node --env-file=.env.local scripts/check-public-access.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "next": "16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
